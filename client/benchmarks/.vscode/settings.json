{
    "kernel.includePaths": ["deptest/lib", "deptest/src/core"],
    "kernel.sourceFiles": ["./global_metrics/main.c",
        "./global_metrics/utils.c"],
    "kernel.macros": [],
    "kernel.machdep": "gcc_x86_32",
    "kernel.noAnnot": false,
    "kernel.lspDebug": 3,
    "wp.rte": true,
    "wp.prover": "script,alt-ergo",
    "wp.timeout": 30,
    "wp.par": 4,
    "wp.cache": "update",
    "wp.script": "batch",
    "wp.session": ".frama-c",
    "metrics.byFunction": true,
    "ccdoc.active": true,
    "dependencies.groups": [
   { "name": "core",    "kind": "core",    "paths": ["deptest/src/core/*.c"] },
        { "name": "auth",    "kind": "feature", "paths": ["deptest/src/features/auth/*.c"] },
        { "name": "billing", "kind": "feature", "paths": ["deptest/src/features/billing/*.c"] },
        { "name": "libs",    "kind": "lib",     "paths": ["deptest/lib/*.c"] }
]
}