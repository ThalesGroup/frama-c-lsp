{
    "name": "acsl-lsp",
    "version": "0.4.0",
    "publisher": "innov-org",
    "engines": {
        "vscode": "^1.85.0"
    },
    "description": "Visual Studio Code Client for ACSL Language Server",
    "license": "SEE LICENSE IN LICENSE.md",
    "displayName": "acsl-lsp",
    "repository": {
        "type": "git",
        "url": "https://github.com/ThalesGroup/frama-c-lsp.git"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "acsl",
        "c",
        "frama-c"
    ],
    "activationEvents": [
        "onLanguage:acsl",
        "onLanguage:c",
        "workspaceContains:**/*.{c,h}"
    ],
    "icon": "images/logo-frama-c.png",
    "main": "./out/extension",
    "capabilities": {
        "definitionProvider": true
    },
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "frama-c-sidebar",
                    "title": "Frama-C Analysis",
                    "icon": "images/logo-frama-c.png"
                }
            ],
            "panel": [
                {
                    "id": "wp-goals-panel",
                    "title": "WP Goals",
                    "icon": "images/logo-frama-c.png"
                }
            ]
        },
        "views": {
            "frama-c-sidebar": [
                {
                    "id": "framaCExplorer",
                    "name": "Explorer",
                    "filterOnType": true
                }
            ],
            "wp-goals-panel": [
                {
                    "id": "wpGoalsView",
                    "name": "Last Results"
                }
            ]
        },
        "menus": {
            "editor/context": [
                {
                    "command": "stop",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "submenu": "Frama-C"
                },
                {
                    "submenu": "Frama-C/WP"
                },
                {
                    "submenu": "Frama-C/CCDOC"
                }
            ],
            "Frama-C": [
                {
                    "command": "acsl.importProjectConfig",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "displayCIL",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "displayCIL_noannot",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "displayCILProject",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "displayCILProject_noannot",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "computeCG",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "computeIncludeGraph",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "showGlobalMetrics",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "showLocalMetrics",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                }
            ],
            "Frama-C/WP": [
                {
                    "command": "provePO",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "provePOStrategies",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "provePOGUI",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "provePOStrategiesGUI",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "provePO Cursor",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "smokeTests",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                },
                {
                    "command": "showPOVC",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                }
            ],
            "view/title": [
                {
                    "command": "framaCExplorer.search",
                    "when": "view == framaCExplorer",
                    "group": "navigation@0"
                },
                {
                    "command": "wpGoalsView.downloadJson",
                    "when": "view == wpGoalsView",
                    "group": "navigation@0"
                },
                {
                    "command": "wpFilters.search",
                    "when": "view == wpGoalsView",
                    "group": "navigation@1"
                },
                {
                    "command": "wpFilters.filterFunction",
                    "when": "view == wpGoalsView",
                    "group": "navigation@2"
                },
                {
                    "command": "wpFilters.filterFile",
                    "when": "view == wpGoalsView",
                    "group": "navigation@3"
                },
                {
                    "command": "wpFilters.filterType",
                    "when": "view == wpGoalsView",
                    "group": "navigation@4"
                },
                {
                    "command": "wpFilters.sortByTime",
                    "when": "view == wpGoalsView",
                    "group": "navigation@5"
                },
                {
                    "command": "framaC.filterAnnotations",
                    "when": "view == framaCExplorer",
                    "group": "navigation@5"
                },
                {
                    "command": "wpFilters.clearAll",
                    "when": "view == wpGoalsView",
                    "group": "navigation@6"
                },
                {
                    "command": "wpFilters.filterProver",
                    "when": "view == wpGoalsView",
                    "group": "1_secondary@1"
                },
                {
                    "command": "wpFilters.filterStatus",
                    "when": "view == wpGoalsView",
                    "group": "1_secondary@2"
                },
                {
                    "command": "wpFilters.toggleSmoke",
                    "when": "view == wpGoalsView",
                    "group": "1_secondary@3"
                },
                {
                    "command": "wpGoalsView.uploadJson",
                    "when": "view == wpGoalsView",
                    "group": "navigation@1"
                },
                {
                    "command": "DisplayAST",
                    "when": "view == framaCExplorer",
                    "group": "navigation@1"
                },
                {
                    "command": "wpFilters.filterVerdict",
                    "group": "navigation@3",
                    "when": "view == wpGoalsView"
                },
                {
                    "command": "wpFilters.toggleHasScript",
                    "group": "navigation@4",
                    "when": "view == wpGoalsView"
                }
            ],
            "Frama-C/CCDOC": [
                {
                    "command": "ccdoc",
                    "when": "resourceLangId == c || resourceLangId == h || resourceLangId == acsl"
                }
            ],
            "view/item/context": [
                {
                    "command": "showScript",
                    "when": "view == wpGoalsView && viewItem == itemContext",
                    "group": "navigation"
                },
                {
                    "command": "showPO",
                    "when": "view == wpGoalsView && viewItem == itemContext",
                    "group": "navigation"
                },
                {
                    "command": "runAgain",
                    "when": "view == wpGoalsView && viewItem == itemContext",
                    "group": "navigation"
                },
                {
                    "command": "runAgainGui",
                    "when": "view == wpGoalsView && viewItem == itemContext",
                    "group": "navigation"
                },
                {
                    "command": "runAgainStrategies",
                    "when": "view == wpGoalsView && viewItem == itemContext",
                    "group": "navigation"
                },
                {
                    "command": "runAgainStrategiesGui",
                    "when": "view == wpGoalsView && viewItem == itemContext",
                    "group": "navigation"
                }
            ]
        },
        "submenus": [
            {
                "id": "Frama-C",
                "label": "Frama-C",
                "icon": "images/logo-frama-c.png"
            },
            {
                "id": "Frama-C/WP",
                "label": "Frama-C/WP",
                "icon": "images/logo-frama-c.png"
            },
            {
                "id": "Frama-C/CCDOC",
                "label": "Frama-C/CCDOC",
                "icon": "images/logo-frama-c.png"
            }
        ],
        "commands": [
            {
                "command": "framaCExplorer.search",
                "title": "Search AST",
                "icon": "$(search)"
            },
            {
                "command": "acsl.computeDependencies",
                "title": "Compute Dependencies (data)"
            },
            {
                "command": "wpGoalsView.downloadJson",
                "title": "Export WP Results (JSON)",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "framaC.filterAnnotations",
                "title": "Filter Annotations by Type",
                "icon": "$(tag)"
            },
            {
                "command": "wpFilters.sortByTime",
                "title": "Sort by Time (Expensive first)",
                "icon": "$(history)"
            },
            {
                "command": "wpFilters.search",
                "title": "WP: Search Goals",
                "icon": "$(search)"
            },
            {
                "command": "wpFilters.filterStatus",
                "title": "WP: Filter by Status",
                "icon": "$(filter)"
            },
            {
                "command": "wpFilters.filterProver",
                "title": "WP: Filter by Prover",
                "icon": "$(circuit-board)"
            },
            {
                "command": "wpFilters.filterFunction",
                "title": "Filter by Function",
                "icon": "$(symbol-method)"
            },
            {
                "command": "wpFilters.filterFile",
                "title": "Filter by File",
                "icon": "$(file)"
            },
            {
                "command": "wpFilters.filterType",
                "title": "Filter by ACSL Type",
                "icon": "$(symbol-property)"
            },
            {
                "command": "wpFilters.toggleSmoke",
                "title": "WP: Toggle Smoke Tests",
                "icon": "$(flame)"
            },
            {
                "command": "wpFilters.filterVerdict",
                "title": "Filter by Verdict (Passed/Failed/Timeout)",
                "icon": "$(filter)"
            },
            {
                "command": "wpFilters.toggleHasScript",
                "title": "Toggle: Only with Scripts",
                "icon": "$(file-code)"
            },
            {
                "command": "wpFilters.clearAll",
                "title": "WP: Clear All Filters",
                "icon": "$(clear-all)"
            },
            {
                "command": "wpGoalsView.uploadJson",
                "title": "Import WP Results (JSON)",
                "icon": "$(cloud-download)"
            },
            {
                "command": "acsl.importProjectConfig",
                "title": " Import Project IDE Configuration",
                "icon": "$(project)"
            },
            {
                "command": "DisplayAST",
                "title": "Update Ast For Current File",
                "icon": "$(refresh)"
            },
            {
                "command": "computeIncludeGraph",
                "title": "Compute Dependency Matrix"
            },
            {
                "command": "displayCIL",
                "title": "Display File CIL"
            },
            {
                "command": "displayCIL_noannot",
                "title": "Display File CIL (-no-annot)"
            },
            {
                "command": "displayCILProject",
                "title": "Display Project CIL"
            },
            {
                "command": "displayCILProject_noannot",
                "title": "Display Project CIL (-no-annot)"
            },
            {
                "command": "computeCG",
                "title": "Generate File CallGraph"
            },
            {
                "command": "showGlobalMetrics",
                "title": "Display Project Metrics"
            },
            {
                "command": "showLocalMetrics",
                "title": "Display File Metrics"
            },
            {
                "command": "smokeTests",
                "title": "Smoke Tests"
            },
            {
                "command": "showPOVC",
                "title": "Display Proof Obligation"
            },
            {
                "command": "showScript",
                "title": "Goto script"
            },
            {
                "command": "showPO",
                "title": "Display Proof Obligation"
            },
            {
                "command": "runAgain",
                "title": "Run proof again"
            },
            {
                "command": "runAgainGui",
                "title": "Run proof again (GUI)"
            },
            {
                "command": "runAgainStrategies",
                "title": "Run proof again with strategies"
            },
            {
                "command": "runAgainStrategiesGui",
                "title": "Run proof again wih strategies (GUI)"
            },
            {
                "command": "provePO",
                "title": "Prove"
            },
            {
                "command": "provePOStrategies",
                "title": "Prove with Strategies"
            },
            {
                "command": "provePOGUI",
                "title": "Prove (GUI)"
            },
            {
                "command": "provePOStrategiesGUI",
                "title": "Prove with Strategies (GUI)"
            },
            {
                "command": "stop",
                "title": "Stop"
            },
            {
                "command": "provePO Cursor",
                "title": "Prove PO Cursor",
                "category": "Frama-C/WP"
            },
            {
                "command": "ccdoc",
                "title": "Run"
            }
        ],
        "grammars": [
            {
                "injectTo": [
                    "source.c"
                ],
                "scopeName": "source.c.acsl",
                "path": "./syntax/acsl.tmLanguage.json"
            }
        ],
        "configuration": [
            {
                "title": "Generic",
                "properties": {
                    "vscodeacsl.maxNumberOfProblems": {
                        "scope": "resource",
                        "type": "number",
                        "default": 10000,
                        "description": "Maximum number of problems produced by the server."
                    }
                }
            },
            {
                "title": "Frama-C/Dependencies",
                "properties": {
                    "dependencies.groups": {
                        "scope": "workspace",
                        "type": "array",
                        "default": [],
                        "description": "Dependency groups for the dependency matrix. Each group has a name, a kind (core | feature | lib) and paths: a folder ending with '/' (all .c files, recursive), a glob pattern such as 'src/core/*.c', or a .c file. Allowed: feature -> core, core -> core, anything -> lib.",
                        "items": {
                            "type": "object",
                            "required": [
                                "name",
                                "kind",
                                "paths"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string"
                                },
                                "kind": {
                                    "type": "string",
                                    "enum": [
                                        "core",
                                        "feature",
                                        "lib"
                                    ]
                                },
                                "paths": {
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            {
                "title": "Frama-C/kernel",
                "properties": {
                    "kernel.lspDebug": {
                        "scope": "window",
                        "type": "integer",
                        "enum": [
                            0,
                            1,
                            2,
                            3
                        ],
                        "default": 0,
                        "description": "Frama-C option: -lsp-debug (0 = off, 1 = handler output, 2 = + JSON messages, 3 = + detailed traces)."
                    },
                    "kernel.serverPort": {
                        "scope": "resource",
                        "type": "integer",
                        "default": 8005,
                        "description": "Server port to ensure sustainable connection with vscode"
                    },
                    "kernel.wrapperPort": {
                        "scope": "resource",
                        "type": "integer",
                        "default": 8006,
                        "description": "Wrapper port to allow request submission to frama-c"
                    },
                    "kernel.includePaths": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Include paths for the project. Frama-C option: -cpp-extra-args \"-I ...\"",
                        "default": []
                    },
                    "kernel.sourceFiles": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Source files.",
                        "default": []
                    },
                    "kernel.macros": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Frama-C option: -cpp-extra-args \"-D ...\"",
                        "default": []
                    },
                    "kernel.macroStrategiesFunctionPrefix": {
                        "scope": "workspace",
                        "type": "string",
                        "description": "Frama-C option: -cpp-extra-args \"-D ...\". Define a macro for each function given with option -wp-fct",
                        "default": ""
                    },
                    "kernel.sourceFileStrategies": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Source files providing strategies.",
                        "default": []
                    },
                    "kernel.sourceFileMetacsl": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Source files providing metaproperties.",
                        "default": []
                    },
                    "kernel.machdep": {
                        "scope": "workspace",
                        "type": "string",
                        "description": "Frama-C option: -machdep. Empty = Frama-C default.",
                        "default": ""
                    },
                    "kernel.keepUnusedFunctions": {
                        "scope": "workspace",
                        "type": "string",
                        "enum": [
                            "none",
                            "user-specified",
                            "all",
                            "all_debug"
                        ],
                        "description": "Frama-C option: -keep-unused-functions (Frama-C default: user-specified).",
                        "default": "user-specified"
                    },
                    "kernel.generatedSpecCustom": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Frama-C option: -generated-spec-custom",
                        "default": []
                    },
                    "kernel.inlineCalls": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Frama-C option: -inline-calls",
                        "default": []
                    },
                    "kernel.removeInlined": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Frama-C option: -remove-inlined",
                        "default": []
                    },
                    "kernel.noAnnot": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -no-annot",
                        "default": false
                    }
                }
            },
            {
                "title": "Frama-C/Uncast",
                "properties": {
                    "uncast.active": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -uncast",
                        "default": false
                    },
                    "uncast.lshiftAsMul": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -uncast-lshift-as-mul",
                        "default": true
                    },
                    "uncast.rshiftAsDiv": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -uncast-rshift-as-div",
                        "default": true
                    },
                    "uncast.endianness": {
                        "scope": "workspace",
                        "type": "string",
                        "description": "Frama-C option: -uncast-endianness",
                        "default": "little"
                    }
                }
            },
            {
                "title": "Frama-C/Metrics",
                "properties": {
                    "metrics.byFunction": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -metrics-by-function",
                        "default": false
                    }
                }
            },
            {
                "title": "Frama-C/Cg",
                "properties": {
                    "callgraph.roots": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Frama-C option: -cg-roots",
                        "default": []
                    },
                    "callgraph.services": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "true: -cg-services, false: -cg-no-services",
                        "default": false
                    }
                }
            },
            {
                "title": "Frama-C/WP",
                "properties": {
                    "diagnostics.wp": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -wp",
                        "default": false
                    },
                    "wp.rte": {
    "type": "boolean",
    "default": true,
    "description": "Generate RTE guards (-wp-rte). Required by the RTE checks run on save."
},
                    "wp.prover": {
                        "scope": "workspace",
                        "type": "string",
                        "default": "alt-ergo",
                        "description": "Frama-C option: -wp-prover"
                    },
                    "wp.timeout": {
                        "scope": "workspace",
                        "type": "integer",
                        "default": 2,
                        "description": "Frama-C option: -wp-timeout (Frama-C default: 2)"
                    },
                    "wp.par": {
                        "scope": "workspace",
                        "type": "integer",
                        "default": 0,
                        "description": "Frama-C option: -wp-par. 0 = Frama-C default (number of cores)."
                    },
                    "wp.session": {
                        "scope": "workspace",
                        "type": "string",
                        "default": "",
                        "description": "Frama-C option: -wp-session"
                    },
                    "wp.script": {
                        "scope": "workspace",
                        "type": "string",
                        "default": "",
                        "description": "Frama-C option: -wp-script"
                    },
                    "wp.cache": {
                        "scope": "workspace",
                        "type": "string",
                        "default": "",
                        "description": "Frama-C option: -wp-cache. Empty = Frama-C default (none)."
                    },
                    "wp.noPruning": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -wp-no-pruning",
                        "default": false
                    },
                    "wp.checkMemoryModel": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -wp-check-memory-model (also sets -wp-model Typed+var+int+float)",
                        "default": false
                    },
                    "wp.noVolatile": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -wp-no-volatile",
                        "default": false
                    },
                    "wp.autoDepth": {
                        "scope": "workspace",
                        "type": "integer",
                        "default": 5,
                        "description": "Frama-C option: -wp-auto-depth (Frama-C default: 5)"
                    },
                    "wp.autoWidth": {
                        "scope": "workspace",
                        "type": "integer",
                        "default": 10,
                        "description": "Frama-C option: -wp-auto-width (Frama-C default: 10)"
                    },
                    "wp.autoBacktrack": {
                        "scope": "workspace",
                        "type": "integer",
                        "default": 0,
                        "description": "Frama-C option: -wp-auto-backtrack. 0 = disabled (Frama-C default)."
                    },
                    "wp.filenameTruncation": {
                        "scope": "workspace",
                        "type": "integer",
                        "default": 0,
                        "description": "Frama-C option: -wp-filename-truncation. 0 = Frama-C default."
                    },
                    "wp.autoProveFunctions": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "description": "List of functions to automatically prove via WP upon saving a file. Use ['@all'] to target all functions."
                    }
                }
            },
            {
                "title": "Frama-C/MetAcsl",
                "properties": {
                    "metacsl.active": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -meta",
                        "default": false
                    },
                    "metacsl.checks": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -meta-checks",
                        "default": true
                    },
                    "metacsl.noSimpl": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -meta-no-simpl",
                        "default": true
                    },
                    "metacsl.noCheckExt": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -meta-no-check-ext",
                        "default": true
                    },
                    "metacsl.numberAssertions": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Frama-C option: -meta-number-assertions",
                        "default": true
                    },
                    "metacsl.checkCalleeAssigns": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
