{
    "name": "vscodeacsl",
    "displayName": "ACSL/C",
    "description": "Visual Studio Code Client for ACSL Language Server",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "https://bitbucket.gemalto.com/users/t0244734/repos/acsl_lsp/browse/Acsl_lsp"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "acsl"
    ],
    "engines": {
        "vscode": "^1.75.0"
    },
    "activationEvents": [
        "onLanguage:c"
    ],
    "main": "./out/extension",
    "contributes": {
        "menus": {
            "editor/context": [
                {
                    "command": "displayCIL",
                    "when": "resourceLangId == acsl"
                },
                {
                    "command": "computeCG",
                    "when": "resourceLangId == acsl"
                },
                {
                    "command": "showPOVC",
                    "when": "resourceLangId == acsl"
                },
                {
                    "command": "showGlobalMetrics",
                    "when": "resourceLangId == acsl"
                },
                {
                    "command": "showLocalMetrics",
                    "when": "resourceLangId == acsl"
                }
            ],
            "editor/title": [
                {
                    "command": "showCG",
                    "when": "resourceLangId == acsl"
                }
            ]
        },
        "submenus": [
            {
                "id": "vscodeacsl.requires",
                "label": "Show 'requires' POs"
            }
        ],
        "languages": [
            {
                "id": "acsl",
                "aliases": [
                    "ACSL",
                    "acsl"
                ],
                "extensions": [
                    ".c",
                    ".h"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "acsl",
                "scopeName": "source.acsl",
                "path": "./syntaxes/acsl.tmLanguage.json"
            }
        ],
        "configuration": [
            {
                "title": "Debugging",
                "properties": {
                    "vscodeacsl.maxNumberOfProblems": {
                        "scope": "resource",
                        "type": "number",
                        "default": 1000,
                        "description": "Controls the maximum number of problems produced by the server."
                    },
                    "acslLsp": {
                        "scope": "window",
                        "type": "integer",
                        "enum": [
                            0,
                            1,
                            2,
                            3,
                            4
                        ],
                        "default": 4,
                        "description": "Specify ACSL LSP debug messages level. (4 = lowest severity, 1 = highest, 0 = off)."
                    }
                }
            },

            {
                "title": "Common",
                "properties": {
                    "kernel.includePaths": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Adds C/C++ include paths for the project."
                    },
                    "kernel.sourceFiles": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Specifies which source files must be parsed."
                    },
                    "kernel.macros": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Adds macros."
                    },
                    "kernel.machdep": {
                        "scope": "workspace",
                        "type": "string",
                        "description": "Specify machdep"
                    },
                    "kernel.keepUnusedSpecifiedFunctions": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Keep unused specified functions",
                        "default": true
                    },
                    "kernel.aggressiveMerging": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Merge function definitions modulo renaming",
                        "default": false
                    }
                }
            },
            {
                "title": "Metrics",
                "properties": {
                    "metrics.output": {
                        "scope": "workspace",
                        "type": "string",
                        "description": "Metrics output file (only works for global metrics, file metrics will generate metrics in a plaintext file with same name as the source file)",
                        "default": ""
                    }
                }
            },
            {
                "title": "Callgraph",
                "properties": {
                    "callgraph.output": {
                        "scope": "workspace",
                        "type": "string",
                        "description": "Callgraph output file (give file name without .dot extension)",
                        "default": ""
                    },
                    "callgraph.roots": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "If not empty, display only the functions of the callgraph reachable from the given functions",
                        "default": ""
                    },
                    "callgraph.services": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Compute and display services (groups of related functions which seem to provide common functionalities) from the callgraph",
                        "default": true
                    }
                }
            },
            {
                "title": "Prove annotations",
                "properties": {
                    "wp.rte": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Generate RTE guards before WP",
                        "default": false
                    },
                    "wp.prover": {
                        "scope": "workspace",
                        "type": "string",
                        "default": "none",
                        "description": "Submit proof obligations to prover(s): 'none' (no prover run), 'script' (replay all session scripts), 'tip' (replay or init scripts for failed goals), '<why3-prover>' (any Why-3 prover, (run 'frama-c -wp-detect' in a terminal to list available provers))"
                    },
                    "wp.timeout": {
                        "scope": "workspace",
                        "type": "integer",
                        "default": 2,
                        "description": "Set the timeout (in seconds) for provers (default: 2)"
                    },
                    "wp.session": {
                        "scope": "workspace",
                        "type": "string",
                        "default": "",
                        "description": "Set the plug-in session directory"
                    }
                }
            },
            {
                "title": "Diagnostics",
                "properties": {
                    "diagnostics.wp": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Enable WP diagnostics. (Not implemented yet)",
                        "default": false
                    }
                }
            },
            {
                "title": "Advanced options",
                "properties": {
                    "wp.pruning": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Prune trivial branches. (set by default)",
                        "default": true
                    },
                    "wp.checkMemoryModel": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Insert memory model hypotheses in function contracts and check them on call.",
                        "default": false
                    },
                    "wp.volatile": {
                        "scope": "workspace",
                        "type": "boolean",
                        "description": "Sound modeling of volatile access. Disable to ignore volatile attributes.",
                        "default": true
                    },
                    "kernel.generatedSpecCustom": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Fine-tune missing specification generation by manually selecting modes for each clause (write it as [clause]:[mode]). Can be one of: frama-c, acsl, safe skip or the name of a custom registered mode. Do not use skip mode for assigns unless you know what you are doing! See Frama-C user manual for more information."
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "displayCIL",
                "title": "Display CIL"
            },
            {
                "command": "computeCG",
                "title": "Compute Callgraph"
            },
            {
                "command": "showPOVC",
                "title": "Proof Obligation(s) of annotation"
            },
            {
                "command": "showGlobalMetrics",
                "title": "Project Metrics"
            },
            {
                "command": "showLocalMetrics",
                "title": "File Metrics"
            },
            {
                "command": "showCG",
                "title": "Show Callgraph"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -b",
        "watch": "tsc -b -w",
        "lint": "eslint ./src --ext .ts,.tsx",
        "test": "sh ./scripts/e2e.sh"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.7",
        "@types/node": "^18.19.44",
        "@types/vscode": "^1.92.0",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.0",
        "minimatch": "^3.1.2",
        "mocha": "^9.2.2",
        "typescript": "^5.5.4"
    },
    "dependencies": {
        "@types/vscode-webview": "^1.57.5",
        "types": "^0.1.1",
        "vscode-languageclient": "^9.0.1"
    }
}
