{
    "name": "vscodeacsl",
    "description": "Visual Studio Code Client for ACSL Language Server",
    "author": "Your Name",
    "license": "MIT",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/your/repo"
    },
    "publisher": "none",
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "multi-root ready",
        "acsl",
        "c"
    ],
    "engines": {
        "vscode": "^1.75.0"
    },
    "activationEvents": [
        "onLanguage:c",
        "onLanguage:cpp"
    ],
    "main": "./out/extension",
    "contributes": {
        "languages": [
            {
                "id": "acsl",
                "aliases": [
                    "ACSL",
                    "acsl"
                ],
                "extensions": [
                    ".c",
                    ".h"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "acsl",
                "scopeName": "source.acsl",
                "path": "./syntaxes/acsl.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Server configuration",
            "properties": {
                "acslClient.maxNumberOfProblems": {
                    "scope": "resource",
                    "type": "number",
                    "default": 1000,
                    "description": "Controls the maximum number of problems produced by the server."
                },
                "acslClient.trace.server": {
                    "scope": "window",
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Traces the communication between VS Code and the language server."
                }
            }
        },
        "commands": [
            {
                "command": "vscodeacsl.definition",
                "title": "ACSL: Go To Definition"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -b",
        "watch": "tsc -b -w",
        "lint": "eslint ./src --ext .ts,.tsx",
        "test": "sh ./scripts/e2e.sh"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.6",
        "@types/node": "^18.19.33",
        "@types/vscode": "^1.89.0",
        "@typescript-eslint/eslint-plugin": "^7.11.0",
        "@typescript-eslint/parser": "^7.11.0",
        "eslint": "^8.57.0",
        "minimatch": "^3.0.2",
        "mocha": "^9.2.1",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "types": "^0.1.1",
        "vscode-languageclient": "^9.0.1"
    }
}
