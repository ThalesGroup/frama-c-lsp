{
    "name": "vscodeacsl",
    "displayName": "ACSL/C",
    "description": "Visual Studio Code Client for ACSL Language Server",
    "author": "Your Name",
    "version": "1.0.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/your/repo"
    },
    "publisher": "none",
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "acsl"
    ],
    "engines": {
        "vscode": "^1.75.0"
    },
    "activationEvents": [
        "onLanguage:c",
        "onLanguage:cpp"
    ],
    "main": "./out/extension",
    "contributes": {
        "menus": {
            "editor/context": [
                {
                    "command": "vscodeacsl.displayCIL"
                }
            ]
        },
        "languages": [
            {
                "id": "acsl",
                "aliases": [
                    "ACSL",
                    "acsl"
                ],
                "extensions": [
                    ".c",
                    ".h"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "acsl",
                "scopeName": "source.acsl",
                "path": "./syntaxes/acsl.tmLanguage.json"
            }
        ],
        "configuration": [
            {
                "title": "Server",
                "properties": {
                    "vscodeacsl.maxNumberOfProblems": {
                        "scope": "resource",
                        "type": "number",
                        "default": 1000,
                        "description": "Controls the maximum number of problems produced by the server."
                    },
                    "vscodeacsl.trace.server": {
                        "scope": "window",
                        "type": "string",
                        "enum": [
                            "off",
                            "messages",
                            "verbose"
                        ],
                        "default": "verbose",
                        "description": "Traces the communication between VS Code and the language server."
                    }
                }
            },
            {
                "title": "Frama-C",
                "properties": {
                    "framac.includePaths": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": "",
                        "description": "Adds C/C++ include paths for the project"
                    },
                    "framac.sourceFiles": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": "",
                        "description": "Specifies which source files must be parsed"
                    },
                    "framac.macros": {
                        "scope": "workspace",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "default": "",
                        "description": "Adds macros"
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "vscodeacsl.displayCIL",
                "title": "Display CIL"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -b",
        "watch": "tsc -b -w",
        "lint": "eslint ./src --ext .ts,.tsx",
        "test": "sh ./scripts/e2e.sh"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.6",
        "@types/node": "^18.18.0",
        "@types/vscode": "^1.75.0",
        "@typescript-eslint/eslint-plugin": "^7.11.0",
        "@typescript-eslint/parser": "^7.11.0",
        "eslint": "^8.57.0",
        "minimatch": "^3.0.2",
        "mocha": "^9.2.1",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "@types/vscode-webview": "^1.57.5",
        "types": "^0.1.1",
        "vscode-languageclient": "^9.0.1"
    }
}