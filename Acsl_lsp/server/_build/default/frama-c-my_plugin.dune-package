(lang dune 3.13)
(name frama-c-my_plugin)
(sections (lib .) (lib_root ..) (libexec .) (bin ../../bin))
(files
 (lib
  (META
   core/my_plugin_lib.a
   core/my_plugin_lib.cma
   core/my_plugin_lib.cmi
   core/my_plugin_lib.cmt
   core/my_plugin_lib.cmx
   core/my_plugin_lib.cmxa
   core/my_plugin_lib.ml
   dune-package
   opam))
 (lib_root (frama-c/plugins/my_plugin/META))
 (libexec (core/my_plugin_lib.cmxs))
 (bin (run.ml)))
(library
 (name frama-c-my_plugin.core)
 (kind normal)
 (archives (byte core/my_plugin_lib.cma) (native core/my_plugin_lib.cmxa))
 (plugins (byte core/my_plugin_lib.cma) (native core/my_plugin_lib.cmxs))
 (native_archives core/my_plugin_lib.a)
 (requires frama-c.kernel)
 (main_module_name My_plugin_lib)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name my_plugin_lib)
     (visibility public)
     (kind alias)
     (source (path My_plugin_lib) (impl (path core/my_plugin_lib.ml-gen))))
    (name My_plugin_lib))
   (wrapped true))))
